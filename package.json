{
  "name": "tarefas-academicas",
  "version": "1.0.0",
  "description": "Gerenciador de tarefas acadêmicas com API REST (Express + SQLite), TDD (Vitest + Supertest) e interface web.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
