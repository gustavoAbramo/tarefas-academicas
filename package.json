{
  "name": "tarefas-academicas",
  "version": "1.0.0",
  "private": true,
  "description": "Gerenciador de tarefas acadêmicas com API REST (Express + SQLite), TDD (Vitest + Supertest) e interface web.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavoAbramo/tarefas-academicas.git"
  },
  "bugs": {
    "url": "https://github.com/gustavoAbramo/tarefas-academicas/issues"
  },
  "homepage": "https://github.com/gustavoAbramo/tarefas-academicas#readme",
  "keywords": [
    "tarefas",
    "academicas",
    "express",
    "sqlite",
    "tdd",
    "vitest"
  ],
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
